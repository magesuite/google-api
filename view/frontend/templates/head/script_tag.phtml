<?php
/** @var \Magento\Framework\Escaper $escaper */
/** @var \MageSuite\GoogleApi\Block\Head\ScriptTag $block */
/** @var \MageSuite\GoogleApi\Model\ViewModel\ScriptTag $viewModel */
$viewModel = $block->getViewModel();
$isConsentRequired = $viewModel->isConsentRequired();
?>

<?php if ($viewModel->shouldScriptTagBeRendered()): ?>
    <!-- libraries=marker is required for AdvancedMarkerElement. v=quarterly uses the latest stable quarterly channel. -->
    <script
        <?php if ($isConsentRequired): ?>
            type="text/html"
            data-consent-service-required="true"
            data-consent-service="googlemaps"
        <?php endif; ?>
        src="https://maps.googleapis.com/maps/api/js?key=<?=$escaper->escapeUrl($viewModel->getFrontendApiKey()) ?>&libraries=marker&v=quarterly"
        src_type="url"
        rel="preconnect">
    </script>
    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], 'window.googleApiConsentRequired = ' . ($isConsentRequired ? 'true' : 'false')); ?>
<?php endif; ?>