<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:MageSuite_Changelog:etc/changelog.xsd">
    <module
        id="MageSuite_GoogleApi"
        name="MageSuite_GoogleApi">
        <changelog>
            <tag version="1.1.9" date="2024-01-05">
                <entry>
                    <type>FEATURE</type>
                    <overview>Add changelog</overview>
                </entry>
                <entry>
                    <type>FEATURE</type>
                    <overview>Add rel=preconnect attribute to script tag</overview>
                    <ticket_id>NKD-3898</ticket_id>
                </entry>
            </tag>
            <tag version="1.2.0" date="2024-12-13">
                <entry>
                    <type>FEATURE</type>
                    <overview>Change script type to text/html and add data attributes required for CMSL</overview>
                    <description>
                        This change is required in order to allow
                        Consent Managed Script Loader (CMSL) to control when
                        Google Maps API can be loaded. That is when user
                        consent is given.
                    </description>
                    <ticket_id>SCAFA-1208</ticket_id>
                </entry>
            </tag>
            <tag version="1.2.2" date="2025-08-14">
                <entry>
                    <type>FIX</type>
                    <overview>Remove async to fix 'google is not defined' JS error</overview>
                    <ticket_id>NKD-5423</ticket_id>
                </entry>
            </tag>
            <tag version="1.2.12" date="2026-09-10">
                <entry>
                    <type>FIX</type>
                    <overview>Remove Google Maps API script from checkout</overview>
                    <description>
                        Checkout does not use the Google Maps JavaScript API - nothing on the
                        page reads the google object and the address fields rely on the
                        browser's native autocomplete. Store locator is unaffected, it
                        registers its own action from magesuite-store-locator.
                    </description>
                    <ticket_id>MGS-5714</ticket_id>
                </entry>
                <entry>
                    <type>FIX</type>
                    <overview>Remove inert rel and src_type attributes from the script tag</overview>
                    <ticket_id>MGS-5714</ticket_id>
                </entry>
                <entry>
                    <type>FIX</type>
                    <overview>Reference head.additional as a block instead of a container</overview>
                    <ticket_id>MGS-5714</ticket_id>
                </entry>
            </tag>
        </changelog>
    </module>
</config>
