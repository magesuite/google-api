<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:MageSuite_Changelog:etc/changelog.xsd">
    <module
        id="MageSuite_GoogleApi"
        name="MageSuite_GoogleApi">
        <changelog>
            <tag version="1.1.9" date="2024-01-05">
                <entry>
                    <type>FEATURE</type>
                    <overview>Add changelog</overview>
                </entry>
                <entry>
                    <type>FEATURE</type>
                    <overview>Add rel=preconnect attribute to script tag</overview>
                    <ticket_id>NKD-3898</ticket_id>
                </entry>
            </tag>
            <tag version="1.2.0" date="2024-12-13">
                <entry>
                    <type>FEATURE</type>
                    <overview>Change script type to text/html and add data attributes required for CMSL</overview>
                    <description>
                        This change is required in order to allow 
                        Consent Managed Script Loader (CMSL) to control when
                        Google Maps API can be loaded. That is when user 
                        consent is given.
                    </description>
                    <ticket_id>SCAFA-1208</ticket_id>
                </entry>
            </tag>
        </changelog>
    </module>
</config>
